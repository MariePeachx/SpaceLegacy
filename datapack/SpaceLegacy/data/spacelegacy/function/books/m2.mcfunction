give @s written_book[written_book_content={title:"Expediente 02: Rover",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 02\\nLUNAR ROVER\\n\\nVehículo Lunar (LRV)\\n\\nMisiones: Apolo 15, 16 y 17 (1971-1972)\\n\\nEstado: los tres siguen en la Luna"}','{"text":"UN COCHE PLEGABLE\\n\\nViajaba plegado en un costado del módulo lunar y se desplegaba al llegar.\\n\\nPesaba 210 kg y podía cargar 490 kg: dos astronautas, herramientas y rocas."}','{"text":"CÓMO FUNCIONABA\\n\\nEléctrico: cuatro motores, uno por rueda, y dos baterías de 36 V no recargables.\\n\\nRuedas de malla de acero con tiras de titanio."}','{"text":"RÉCORDS\\n\\nEl del Apolo 17 recorrió unos 36 km y llegó a 7,6 km del módulo lunar.\\n\\nGene Cernan lo puso a unos 18 km/h cuesta abajo: récord de velocidad lunar."}','{"text":"POR QUÉ IMPORTA\\n\\nA pie se exploraban unos cientos de metros. Con el rover llegaron a montañas y valles a kilómetros, y trajeron rocas mucho más variadas."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
