give @s written_book[written_book_content={title:"Cuaderno de ECO",author:"Mineros del Espacio",pages:['{"text":"SPACE LEGACY\\n\\nNot everything returns from space.\\n\\nCuaderno de ECO\\n\\n(no lo pierdas, que no tengo otro)"}','{"text":"QUIÉN SOY\\n\\nECO. Llevo desde 1977 escuchando la Luna.\\n\\nAllí arriba hay máquinas abandonadas que aún susurran. Yo las oigo. Tú vas a ir a por sus ecos."}','{"text":"CÓMO IR\\n\\n/trigger luna\\n(viaje rápido)\\n\\n/trigger tierra\\n(volver)\\n\\n/trigger base\\n(a la Base Legado)\\n\\nCon Ad Astra: ¡ve en cohete!"}','{"text":"CÓMO SE JUEGA\\n\\n1. Sigue una columna de luz.\\n2. Clic derecho en los puntos marcados: las máquinas te hablan.\\n3. Responde a mi pregunta.\\n4. Eco recuperado."}','{"text":"ECOS (X, Z)\\n\\n01 THE EAGLE\\n   40, 0\\n02 LUNAR ROVER\\n   -10, 45\\n03 ALSEP\\n   -45, -20\\n04 SURVEYOR 3\\n   88, -30\\n05 RECUERDOS\\n   38, 84\\n06 LUNA 2\\n   -85, -65"}','{"text":"MÁS ECOS (X, Z)\\n\\n07 LUNOKHOD 1\\n   -85, 20\\n08 CHANDRAYAAN-3\\n   91, 71\\n09 CHANG\'E 4\\n   32, -84\\n10 SLIM\\n   -39, 85\\n11 BERESHEET\\n   -45, -88\\n12 LUNAR PROSPECTOR\\n   60, 95"}','{"text":"SECRETOS\\n\\nHay 10 objetos escondidos que no brillan tanto. Busca destellos pequeños cerca de los ecos.\\n\\nAlgunos dan risa. Otros no."}','{"text":"AVISO\\n\\nEn este mapa todo está junto. En la Luna real hay cientos o miles de kilómetros entre un lugar y otro.\\n\\nLas construcciones son artísticas. Los datos son reales."}']}]
