give @s written_book[written_book_content={title:"Expediente 08: Chandrayaan",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 08\\nCHANDRAYAAN-3\\n\\nMisión de la agencia india ISRO\\n\\nLanzamiento: 14 de julio de 2023\\nAlunizaje: 23 de agosto de 2023\\nLatitud: unos 69° sur"}','{"text":"DOS MÁQUINAS\\n\\nVikram, el módulo de aterrizaje, llevaba dentro a Pragyan, un rover de 26 kg que bajó por una rampa.\\n\\nChandrayaan significa «vehículo lunar»."}','{"text":"POR QUÉ EL SUR\\n\\nCerca del polo sur hay cráteres donde nunca da el sol y puede haber hielo de agua.\\n\\nEse hielo sería muy valioso para futuras bases."}','{"text":"QUÉ MIDIÓ\\n\\n- Azufre y otros elementos.\\n- La temperatura bajo el suelo.\\n- Vibraciones del terreno.\\n\\nTrabajó un día lunar: unas dos semanas."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: ISRO (isro.gov.in) y NASA NSSDCA."}']}]
