give @s written_book[written_book_content={title:"Expediente 07: Lunokhod 1",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 07\\nLUNOKHOD 1\\n\\nRover de la Unión Soviética\\nLlegó con la nave Luna 17\\n\\nAlunizaje: 17 de noviembre de 1970\\nLugar: Mar de las Lluvias"}','{"text":"UNA BAÑERA CON RUEDAS\\n\\nPesaba 756 kg y medía más de dos metros.\\n\\nLlevaba cámaras, instrumentos para analizar el suelo y un espejo láser francés."}','{"text":"DÍA Y NOCHE\\n\\nTrabajaba de día con energía solar.\\n\\nDe noche cerraba la tapa y aguantaba el frío con el calor de un material radiactivo."}','{"text":"RESULTADOS\\n\\nPensado para tres meses, funcionó unos diez.\\n\\nRecorrió 10,5 km y envió más de 20.000 imágenes."}','{"text":"PERDIDO Y ENCONTRADO\\n\\nDurante décadas no se supo dónde estaba.\\n\\nEn 2010 la sonda LRO lo localizó y su espejo volvió a usarse."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
