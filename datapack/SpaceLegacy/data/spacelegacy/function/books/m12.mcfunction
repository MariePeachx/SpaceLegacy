give @s written_book[written_book_content={title:"Expediente 12: Prospector",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 12\\nLUNAR PROSPECTOR\\n\\nSonda orbital de la NASA\\n\\nLanzamiento: enero de 1998\\nImpacto: 31 de julio de 1999\\nLugar: polo sur lunar"}','{"text":"BUSCANDO AGUA\\n\\nNunca aterrizó: midió la Luna desde la órbita.\\n\\nEncontró mucho hidrógeno en los polos, señal de hielo escondido en cráteres siempre en sombra."}','{"text":"GENE SHOEMAKER\\n\\nGeólogo. Soñaba con ser astronauta y un problema de salud se lo impidió.\\n\\nFormó a los del Apolo y codescubrió el cometa Shoemaker-Levy 9."}','{"text":"EL VIAJE\\n\\nMurió en 1997. Una pequeña cápsula con parte de sus cenizas viajó en la sonda, envuelta en una lámina grabada con unos versos de Shakespeare."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
