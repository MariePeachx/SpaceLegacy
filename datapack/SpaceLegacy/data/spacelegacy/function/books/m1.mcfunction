give @s written_book[written_book_content={title:"Expediente 01: Eagle",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 01\\nTHE EAGLE\\n\\nMódulo lunar del Apolo 11 (LM-5)\\n\\nLugar: Mar de la Tranquilidad\\n0,67° N, 23,47° E\\n\\nAlunizaje: 20 de julio de 1969, 20:17 UTC"}','{"text":"LA TRIPULACIÓN\\n\\nNeil Armstrong y Buzz Aldrin bajaron a la superficie. Michael Collins les esperó en órbita, en el módulo Columbia.\\n\\nEl paseo lunar duró 2 horas y 31 minutos."}','{"text":"QUÉ SE QUEDÓ\\n\\n- La etapa de descenso.\\n- La placa de la escalera.\\n- La bandera, tumbada.\\n- Dos experimentos.\\n- Mochilas, botas y bolsas que tiraron para pesar menos."}','{"text":"CIENCIA\\n\\nUn sismómetro que funcionó unas semanas y un retrorreflector láser que se sigue usando: la Luna se aleja de la Tierra unos 3,8 cm cada año."}','{"text":"QUÉ VOLVIÓ\\n\\nTres astronautas y 21,5 kg de rocas lunares.\\n\\nLa etapa de ascenso se soltó en órbita lunar. Nadie sabe con certeza dónde acabó."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
