give @s written_book[written_book_content={title:"Expediente 10: SLIM",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 10\\nSLIM\\n\\nSmart Lander for Investigating Moon\\n\\nAgencia japonesa JAXA\\n\\nAlunizaje: 19 de enero de 2024\\nLugar: junto al cráter Shioli"}','{"text":"PUNTERÍA\\n\\nSu objetivo era caer a menos de 100 metros de un punto elegido. Lo logró: 55 metros.\\n\\nUsaba cámaras para reconocer los cráteres mientras bajaba."}','{"text":"DE CABEZA\\n\\nA 50 metros del suelo perdió la tobera de uno de sus dos motores y acabó apoyada sobre el morro.\\n\\nSus paneles solares quedaron mirando al oeste."}','{"text":"LOS DOS ROBOTS\\n\\nAntes de tocar el suelo soltó dos minirrobots. Uno, SORA-Q, es una bola que se abre y rueda.\\n\\nSLIM sobrevivió a varias noches lunares, cosa que nadie esperaba."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: JAXA (Agencia Espacial Japonesa) y NASA NSSDCA."}']}]
