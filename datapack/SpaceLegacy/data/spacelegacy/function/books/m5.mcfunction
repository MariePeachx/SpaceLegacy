give @s written_book[written_book_content={title:"Expediente 05: Recuerdos",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 05\\nRECUERDOS\\n\\nObjetos personales dejados por astronautas\\n\\nMisiones: Apolo 14, 15 y 16\\n\\nAños: 1971 y 1972"}','{"text":"EL ASTRONAUTA CAÍDO\\n\\nFigurita de aluminio de 8,5 cm con una placa de 14 nombres: ocho astronautas y seis cosmonautas.\\n\\nApolo 15, 1 de agosto de 1971."}','{"text":"MARTILLO Y PLUMA\\n\\nUn martillo de 1,3 kg y una pluma de halcón de 30 gramos cayeron a la vez.\\n\\nUn experimento de física en directo."}','{"text":"GOLF EN LA LUNA\\n\\nAlan Shepard golpeó dos pelotas el 6 de febrero de 1971.\\n\\nLas fotos han permitido medirlo después: unos 22 y unos 37 metros."}','{"text":"UNA FOTO\\n\\nCharlie Duke dejó el retrato de su familia en abril de 1972.\\n\\nNada de esto servía a la ciencia. Sirve para recordar que allí hubo personas."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
