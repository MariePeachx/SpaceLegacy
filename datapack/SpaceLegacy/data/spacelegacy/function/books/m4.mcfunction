give @s written_book[written_book_content={title:"Expediente 04: Surveyor 3",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 04\\nSURVEYOR 3\\n\\nSonda robótica de la NASA\\n\\nLugar: Océano de las Tormentas\\n\\nAlunizaje: 20 de abril de 1967"}','{"text":"PARA QUÉ SIRVIÓ\\n\\nAntes de enviar personas había que saber si el suelo aguantaría una nave.\\n\\nLas Surveyor aterrizaron, hicieron fotos y tocaron el suelo."}','{"text":"CON BOTES\\n\\nLos motores no se apagaron cuando debían y la sonda rebotó dos veces.\\n\\nAun así envió más de 6.000 imágenes y cavó zanjas con su pala."}','{"text":"LA VISITA\\n\\nEl 19 de noviembre de 1969 el Apolo 12 alunizó a menos de 200 metros.\\n\\nConrad y Bean se llevaron la cámara, la pala y trozos de tubo."}','{"text":"QUÉ QUEDA\\n\\nEl resto de la sonda sigue en la Luna, dentro de un cráter.\\n\\nLas piezas que volvieron enseñaron cómo envejecen los materiales en el espacio."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
