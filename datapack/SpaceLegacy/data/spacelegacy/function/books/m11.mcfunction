give @s written_book[written_book_content={title:"Expediente 11: Beresheet",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 11\\nBERESHEET\\n\\nNave de la organización israelí SpaceIL\\n\\nLanzamiento: 22 de febrero de 2019\\nChoque: 11 de abril de 2019\\nLugar: Mar de la Serenidad"}','{"text":"CASI\\n\\nIba a ser el primer alunizaje privado. A pocos kilómetros del suelo falló el motor principal y no pudo frenar.\\n\\nBeresheet significa «en el principio»."}','{"text":"LA BIBLIOTECA\\n\\nLlevaba un disco con 30 millones de páginas: enciclopedias, libros, idiomas.\\n\\nY, pegados con resina, miles de tardígrados deshidratados."}','{"text":"¿HAY VIDA EN LA LUNA?\\n\\nSi alguno sobrevivió, está dormido: sin agua no puede despertar.\\n\\nAbrió un debate serio: qué se puede dejar en otros mundos, y quién lo decide."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: SpaceIL, Arch Mission Foundation y NASA (imágenes de la sonda LRO)."}']}]
