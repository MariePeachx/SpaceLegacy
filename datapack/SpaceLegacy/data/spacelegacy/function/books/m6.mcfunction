give @s written_book[written_book_content={title:"Expediente 06: Luna 2",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 06\\nLUNA 2\\n\\nSonda de la Unión Soviética\\n\\nLanzamiento: 12 de septiembre de 1959\\n\\nImpacto: 13 de septiembre de 1959 (hora universal)"}','{"text":"LA PRIMERA\\n\\nFue el primer objeto fabricado por humanos que tocó otro cuerpo celeste.\\n\\nCayó cerca de los cráteres Arquímedes y Autólico."}','{"text":"CÓMO ERA\\n\\nUna esfera de 390 kg con antenas e instrumentos. Sin motor propio: viajó casi en línea recta durante un día y medio."}','{"text":"CIENCIA DE CAMINO\\n\\nMidió hasta el último segundo.\\n\\nNo encontró un campo magnético apreciable en la Luna y confirmó que existe el viento solar."}','{"text":"QUÉ QUEDA\\n\\nA esa velocidad, poco: fragmentos y quizá algunos banderines.\\n\\nNadie ha fotografiado todavía el punto exacto del impacto."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
