give @s written_book[written_book_content={title:"Expediente 03: ALSEP",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 03\\nALSEP\\n\\nApollo Lunar Surface Experiments Package\\n\\nMisiones: Apolo 12, 14, 15, 16 y 17\\n\\nActivas: de 1969 a 1977"}','{"text":"UN LABORATORIO SIN GENTE\\n\\nLos astronautas lo montaban a mano, a unos 100 metros del módulo lunar.\\n\\nCada estación tenía instrumentos distintos unidos por cables a una central."}','{"text":"ENERGÍA NUCLEAR\\n\\nEl generador SNAP-27 usaba el calor del plutonio-238 para dar unos 70 vatios, día y noche.\\n\\nCon paneles solares no habría bastado."}','{"text":"QUÉ DESCUBRIÓ\\n\\n- Miles de lunamotos, algunos a 700-1000 km de profundidad.\\n- Impactos de meteoritos.\\n- El calor que sale del interior.\\n- El viento solar."}','{"text":"EL FINAL\\n\\nLa NASA apagó las cinco estaciones el 30 de septiembre de 1977.\\n\\nSiguen allí, en silencio."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: NASA NSSDCA (nssdc.gsfc.nasa.gov), Apollo Lunar Surface Journal (NASA History) y NASA Science."}']}]
