give @s written_book[written_book_content={title:"Expediente 09: Chang'e 4",author:"Mineros del Espacio",pages:['{"text":"EXPEDIENTE 09\\nCHANG\'E 4\\n\\nMisión de China (CNSA)\\n\\nAlunizaje: 3 de enero de 2019\\n\\nLugar: cráter Von Kármán, cara oculta"}','{"text":"LA CARA OCULTA\\n\\nLa Luna siempre nos enseña la misma cara. La otra no es oscura: simplemente no se ve desde aquí.\\n\\nNadie se había posado en ella."}','{"text":"UN JARDÍN DIMINUTO\\n\\nLlevaba semillas en un recipiente cerrado. Una de algodón germinó.\\n\\nMurió con el frío de la primera noche lunar."}','{"text":"YUTU-2\\n\\nUn rover de 140 kg con seis ruedas. Su radar ha estudiado las capas del suelo hasta decenas de metros.\\n\\nEn este mapa verás la Tierra en el cielo: desde el lugar real no se ve."}','{"text":"NOTA\\n\\nEsta recreación en Minecraft es artística. Los datos son reales.\\n\\nFuentes: CNSA (Administración Espacial China) y NASA NSSDCA."}']}]
